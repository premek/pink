#!/bin/env lua
if not arg[1] then
    error('\nUsage: ' .. arg[0] .. ' [-v] [--profile] [--compat] [format] game.ink\n')
end

local logging = require('pink.logging')
local formatter = require('pink.formatter')
local runtime = require('pink.runtime')
local load = require('pink.loader')

-- TODO order should not be significant
if arg[1] == '-v' then
    logging.debugEnabled = true
    table.remove(arg, 1)
end

local profile = false
if arg[1] == '--profile' then
    profile = true
    table.remove(arg, 1)
end

if arg[1] == '--compat' then
    logging.compat = true
    table.remove(arg, 1)
end

local format = false
if arg[1] == 'format' then
    format = true
    table.remove(arg, 1)
end

local filename = arg[1]

if format then
    print(formatter(load(filename)))
    return
end

if profile then
    for _ = 1, 40 do
        runtime(load(filename))
    end
    return
end

local story = runtime(load(filename))
while true do
    while story.canContinue do
        io.write(story.continue())
        if #story.currentTags > 0 then
            print('# tags: ' .. table.concat(story.currentTags, ', ')) -- TODO configurable
        end
    end
    if #story.currentChoices == 0 then
        break
    end
    for i = 1, #story.currentChoices do
        print(i .. ': ' .. story.currentChoices[i].text)
    end
    io.write('?> ')
    local answer = tonumber(io.read('*number'))
    if not answer then
        error('missing answer')
    end
    if not answer or answer > #story.currentChoices then
        error('invalid answer: ' .. tostring(answer))
    end
    story.chooseChoiceIndex(answer)
end
